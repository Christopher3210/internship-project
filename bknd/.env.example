PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=replace_me
DATABASE_NAME=app_dev
JWT_SECRET=replace_with_a_long_random_secret
REDIS_URL=redis://localhost:6379

# Read-only business result cache (never caches writes or task creation).
AI_CHAT_CACHE_ENABLED=true
AI_CHAT_CACHE_TTL_SECONDS=600
AI_CACHE_COMPANIES_ENABLED=true
AI_CACHE_COMPANIES_TTL_SECONDS=600
AI_CACHE_USERS_ENABLED=true
AI_CACHE_USERS_TTL_SECONDS=600
# Future LangGraph checkpoints are temporary, separate from PostgreSQL task records.
AI_TASK_STATE_TTL_SECONDS=86400
# Deployment-owned tenant mapping. Do not accept tenant IDs from chat/request input.
AI_TENANT_ID=local
AI_USER_TENANTS={}

# AI chat defaults to a local mock so the UI works without an external API key.
AI_PROVIDER=mock

# Optional OpenAI-compatible providers. Add keys only to your local .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
