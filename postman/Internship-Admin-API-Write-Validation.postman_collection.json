          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.environment.set('testCompanyCode', `PMTEST${Date.now()}`);"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));", "pm.test('Created company has the submitted data', () => { pm.expect(body.companyCode).to.eql(pm.environment.get('testCompanyCode')); pm.expect(body.companyName).to.eql('Postman Test Company'); pm.expect(body.level).to.eql(2); });", "pm.test('Response time is within target', () => pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('maxResponseTimeMs') || 3000)));", "pm.environment.set('testCompanyCode', body.companyCode);"] } }
          ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"companyCode\": \"{{testCompanyCode}}\",\n  \"companyName\": \"Postman Test Company\",\n  \"level\": 2,\n  \"country\": \"United Kingdom\",\n  \"city\": \"London\",\n  \"foundedYear\": 2020,\n  \"annualRevenue\": 100000,\n  \"employees\": 25\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/companies" }
