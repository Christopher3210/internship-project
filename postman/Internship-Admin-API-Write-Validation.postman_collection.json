          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"companyName\": \"Nobody\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/companies/PMTEST_DOES_NOT_EXIST" }
