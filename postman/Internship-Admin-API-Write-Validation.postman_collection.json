          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"companyCode\": \"INVALIDLEVEL\",\n  \"companyName\": \"Invalid Level Company\",\n  \"level\": 5,\n  \"country\": \"United Kingdom\",\n  \"city\": \"London\",\n  \"foundedYear\": 2020,\n  \"annualRevenue\": 100000,\n  \"employees\": 25\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/companies" }
        },
        {
          "name": "PATCH /companies/{companyCode} - update test company",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));", "pm.test('Updated fields are returned', () => { pm.expect(body.companyCode).to.eql(pm.environment.get('testCompanyCode')); pm.expect(body.companyName).to.eql('Postman Updated Company'); pm.expect(body.employees).to.eql(30); });", "pm.test('Response time is within target', () => pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('maxResponseTimeMs') || 3000)));" ] } }],
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"companyName\": \"Postman Updated Company\",\n  \"employees\": 30\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/companies/{{testCompanyCode}}" }
        },
